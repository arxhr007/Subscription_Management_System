    "typecheck": "tsc -p .",
    "bootstrap": "tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@brightloop/shared": "workspace:*",
    "@prisma/client": "^6.16.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.3.0",
    "zod": "^4.6.7",
    "@supabase/supabase-js": "2.118.0",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.3"
  }
}
