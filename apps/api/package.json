{
  "name": "@brightloop/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "db:setup": "prisma migrate deploy && prisma generate",
    "seed": "tsx prisma/seed.ts",
    "samples": "tsx scripts/samples.ts",
    "check:idempotency": "tsx scripts/check-idempotency.ts",
