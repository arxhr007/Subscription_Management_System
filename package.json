{
  "name": "brightloop",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "pnpm --filter @brightloop/api db:setup",
    "dev": "pnpm --parallel --filter @brightloop/api --filter @brightloop/web dev",
    "test": "vitest run",
    "typecheck": "pnpm exec tsc -p packages/shared && pnpm --filter @brightloop/api typecheck && pnpm --filter @brightloop/web typecheck",
    "build": "pnpm --filter @brightloop/web build",
    "test:integration": "node scripts/test-postgres.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module"
}
